# Copy to .env (server) and .env.local (frontend). Never commit real secrets.

# --- Frontend (Vite) ---
# true = auth + catalog/news from self-hosted API; false = local IndexedDB demo
VITE_USE_API=false
# Empty in dev (Vite proxies /api). Production: https://your.domain or https://api.your.domain
VITE_API_URL=

# --- API server ---
PORT=3001
DATABASE_URL=postgresql://rybalka:password@localhost:5432/rybalka
JWT_SECRET=change-me-to-long-random-string
UPLOAD_DIR=./uploads
# Public site URL (used for YooKassa return_url)
PUBLIC_SITE_URL=https://your.domain

# Yandex Maps (client)
VITE_YANDEX_MAPS_API_KEY=YOUR_YANDEX_MAPS_API_KEY

# --- YooKassa (server only — NEVER VITE_*) ---
# test | production — use matching shop credentials
PAYMENT_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 54-FZ receipt: 1 = без НДС (часто для УСН/услуг). При необходимости: 2–6
YOOKASSA_VAT_CODE=1
# Система налогообложения (опционально): 1=ОСН, 2=УСН доходы, 3=УСН доходы-расходы, …
# YOOKASSA_TAX_SYSTEM_CODE=2
# Optional explicit return URL template (may include :orderId)
# YOOKASSA_RETURN_URL=https://your.domain/owner/payment/result/:orderId
# Webhook URL to set in YooKassa cabinet:
# YOOKASSA_WEBHOOK_URL=https://your.domain/api/yookassa/webhook

# Optional email (server only)
# RESEND_API_KEY=
