# Copy to .env (server) and .env.local (frontend). Never commit real secrets.

# --- Frontend (Vite) ---
# true = auth + catalog/news from self-hosted API; false = local IndexedDB demo
VITE_USE_API=false
# Empty in dev (Vite proxies /api). Production: https://your.domain or https://api.your.domain
VITE_API_URL=

# --- API server ---
PORT=3001
DATABASE_URL=postgresql://rybalka:password@localhost:5432/rybalka
JWT_SECRET=change-me-to-long-random-string
UPLOAD_DIR=./uploads

# Yandex Maps (client)
VITE_YANDEX_MAPS_API_KEY=YOUR_YANDEX_MAPS_API_KEY

# Optional payments / email (server only — never VITE_*)
# YOOKASSA_SECRET_KEY=
# RESEND_API_KEY=
