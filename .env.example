# Copy to .env.local / .env and fill values. Never commit real keys.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# When true + credentials set: auth + bases go to Supabase Postgres.
# When false: auth local, bases stored in IndexedDB (still a DB, no demoData).
VITE_USE_SUPABASE=false

# Apply migrations: supabase db push
# (includes base listing moderation: approved/rejected + fields)

# Email (server / Edge Function only — never expose in VITE_*)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@fishing-ural.ru
# Outbox table: supabase/migrations/20260827120800_email_outbox.sql
# Stub: supabase/functions/send-email/README.md

# Local demo accounts (only when VITE_USE_SUPABASE=false):
# USER  user@demo.local  / demo1234
# OWNER owner@demo.local / demo1234
# ADMIN admin@demo.local / demo1234

# Yandex Maps (restrict key by HTTP referrer in Yandex Cabinet)
VITE_YANDEX_MAPS_API_KEY=YOUR_YANDEX_MAPS_API_KEY

# Payments — PUBLIC only in Vite (shop id / merchant login). Secrets stay on server.
# VITE_YOOKASSA_SHOP_ID=
# VITE_ROBOKASSA_MERCHANT_LOGIN=
# VITE_ROBOKASSA_IS_TEST=true
# VITE_PAYMENT_RETURN_URL=https://your.domain/owner/payments/return
# VITE_PAYMENTS_SIMULATE=true
#
# Server / Edge Function secrets (NEVER prefix with VITE_):
# YOOKASSA_SECRET_KEY=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# See supabase/functions/payments/README.md
